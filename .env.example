# --- elementclaude ---

# Host port (reserved via `ports --reserve elementclaude`)
HOST_PORT=7075

# Where Claude API talks to
ANTHROPIC_API_KEY=sk-ant-...

# Optional: route Claude API calls through a proxy / alt endpoint.
# Leave commented to use the default https://api.anthropic.com.
# ANTHROPIC_BASE_URL=https://my-proxy.example.com

# --- Bridge to messaging-bot ---

# messaging-bot connection.
# Host mode (recommended): http://localhost:9985
# Docker mode:             http://messaging-bot:8000
MESSAGING_BOT_URL=http://localhost:9985
MESSAGING_BOT_API_KEY=mb_...

# How messaging-bot reaches us (used to auto-create the webhook rule on first start).
# Host mode:   http://<docker-bridge-ip>:7075  (find with `ip -4 addr show docker0`)
# Docker mode: http://elementclaude:8000
ELEMENTCLAUDE_INTERNAL_URL=http://172.17.0.1:7075

# HMAC secret messaging-bot will sign webhook deliveries with.
# Generate a strong one: `openssl rand -hex 32`
WEBHOOK_SECRET=change-me-to-a-strong-random-hex-string

# --- Auth ---

# Initial admin Matrix user ID. Can manage room whitelist via !auth.
INITIAL_ADMIN_USER=@js:matrix.org

# --- Claude defaults ---

DEFAULT_MODEL=claude-opus-4-7
DEFAULT_MODE=default

# Optional sandbox: if set, !cwd is restricted to paths under this root.
# Leave commented = no restriction (any directory the bot can read).
# In docker mode this also needs to match the host path so session resume works.
# WORKSPACE_ROOT=/home/js/Projekte

# --- Misc ---

DATA_DIR=./data
LOG_LEVEL=INFO
