# --- elementclaude ---

# Host port (reserved via `ports --reserve elementclaude`)
HOST_PORT=7075

# Where Claude API talks to
ANTHROPIC_API_KEY=sk-ant-...

# --- Bridge to messaging-bot ---

# Internal URL inside the matrix-tools Docker network.
# messaging-bot exposes :8000 inside the network, :9985 on the host.
MESSAGING_BOT_URL=http://messaging-bot:8000
MESSAGING_BOT_API_KEY=mb_...

# How messaging-bot reaches us (used to auto-create the webhook rule on first start).
# This is OUR address as seen from the messaging-bot container.
ELEMENTCLAUDE_INTERNAL_URL=http://elementclaude:8000

# HMAC secret messaging-bot will sign webhook deliveries with.
# Generate a strong one: `openssl rand -hex 32`
WEBHOOK_SECRET=change-me-to-a-strong-random-hex-string

# --- Auth ---

# Initial admin Matrix user ID. Can manage room whitelist via !auth.
INITIAL_ADMIN_USER=@js:matrix.org

# --- Claude defaults ---

DEFAULT_MODEL=claude-opus-4-7
DEFAULT_MODE=default

# Where Claude can read/write inside the container. The host's ~/Projekte
# is mounted to /host/projekte (see docker-compose.yml). cwd must live under this.
WORKSPACE_ROOT=/host/projekte

# --- Misc ---

DATA_DIR=/data
LOG_LEVEL=INFO
