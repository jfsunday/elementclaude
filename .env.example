# --- elementclaude ---

# Host port (reserved via `ports --reserve elementclaude`)
HOST_PORT=7075

# Where Claude API talks to
ANTHROPIC_API_KEY=sk-ant-...

# Optional: route Claude API calls through a proxy / alt endpoint.
# Leave commented to use the default https://api.anthropic.com.
# ANTHROPIC_BASE_URL=https://my-proxy.example.com

# --- Bridge to messaging-bot ---

# messaging-bot connection.
# Host mode (recommended): http://localhost:9985
# Docker mode:             http://messaging-bot:8000
MESSAGING_BOT_URL=http://localhost:9985
MESSAGING_BOT_API_KEY=mb_...

# How messaging-bot reaches us (used to auto-create the webhook rule on first start).
# Host mode:   http://<docker-bridge-ip>:7075  (find with `ip -4 addr show docker0`)
# Docker mode: http://elementclaude:8000
ELEMENTCLAUDE_INTERNAL_URL=http://172.17.0.1:7075

# HMAC secret messaging-bot will sign webhook deliveries with.
# Generate a strong one: `openssl rand -hex 32`
WEBHOOK_SECRET=change-me-to-a-strong-random-hex-string

# --- Auth ---

# Initial admin Matrix user ID. Can manage room whitelist via !auth.
INITIAL_ADMIN_USER=@js:matrix.org

# --- Claude defaults ---

DEFAULT_MODEL=claude-opus-4-7
DEFAULT_MODE=default

# Optional sandbox: if set, !cwd is restricted to paths under this root.
# Leave commented = no restriction (any directory the bot can read).
# In docker mode this also needs to match the host path so session resume works.
# WORKSPACE_ROOT=/home/js/Projekte

# --- Voice (STT / TTS) ---
# Needs the optional `voice` extra. `uv run` re-syncs the venv on every start, so
# pass it via EXTRAS instead of installing by hand: `EXTRAS=voice ./run-host.sh`.
# In docker mode the extra is already part of the image.
# Per-room toggles live in the room itself (`!voice on`, `!voice engine local`);
# these are only the defaults + backend configuration.

VOICE_ENABLED_DEFAULT=false
VOICE_ENGINE_DEFAULT=cloud

# Local STT (faster-whisper, fully offline; first use downloads the model).
STT_MODEL=medium
STT_COMPUTE_TYPE=int8
# STT_LANGUAGE=de          # leave unset to autodetect
STT_MAX_SECONDS=300

# Cloud STT. There is no keyless free Whisper API — without a token, `engine cloud`
# falls back to local transcription and says so in the room.
# HuggingFace inference (free tier) is the default URL; a token is a free signup.
# Note: the legacy api-inference.huggingface.co host is retired — use router.huggingface.co.
# For an OpenAI-compatible endpoint (e.g. Groq) use a URL ending in
# /audio/transcriptions — STT_API_MODEL is then mandatory (a faster-whisper size
# like "medium" is not a valid model id there).
STT_API_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3
# STT_API_TOKEN=hf_...
# Groq free tier instead:
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_API_MODEL=whisper-large-v3

# Cloud TTS = edge-tts (Microsoft Edge read-aloud, no API key, free).
# Voice list: `edge-tts --list-voices`
TTS_VOICE=de-DE-KatjaNeural
TTS_MAX_CHARS=1200

# Local TTS: piper if a voice model is present, otherwise espeak-ng.
# PIPER_MODEL_PATH=/home/js/.local/share/piper/de_DE-thorsten-medium.onnx

# --- Misc ---

DATA_DIR=./data
LOG_LEVEL=INFO
